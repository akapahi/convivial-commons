[Unit]
Description=Convivial Commons AI Debate Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/convivial-commons
EnvironmentFile=-/etc/convivial-commons/convivial.env
ExecStart=/home/pi/convivial-commons/.venv/bin/uvicorn convivial:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
